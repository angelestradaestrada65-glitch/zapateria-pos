	<artifactId>zapateria-web</artifactId>

	<dependencies>
		<dependency>
			<groupId>com.miapp.zapateria</groupId>
			<artifactId>zapateria-model</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
